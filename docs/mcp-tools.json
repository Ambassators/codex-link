          "type": "integer",
          "minimum": 0,
          "maximum": 32767,
          "description": "Y in observation-image pixels"
        },
        "toX": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32767,
          "description": "Drag destination X in observation-image pixels"
        },
        "toY": {
