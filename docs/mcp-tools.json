            "key",
            "invoke",
            "set_value",
            "select",
            "toggle",
            "expand",
            "collapse",
            "focus"
          ]
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32767,
          "description": "X in observation-image pixels"
        },
