  {
    "name": "file_write",
    "description": "Create or replace a UTF-8 file. An existing file requires its current expectedHash. Returns an approval-gated job; inspect job_get before claiming success.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "description": "Name returned by workspace_list"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Path relative to the approved workspace root"
        },
        "text": {
          "type": "string",
          "maxLength": 1048576
        },
        "expectedHash": {
          "type": [
            "string",
            "null"
          ],
          "description": "SHA-256 returned by file_read; null ONLY when creating a new file.",
          "pattern": "^[a-f0-9]{64}$"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Unique idempotency key for a write/job. Reuse only to retry exactly the same operation."
        }
      },
      "required": [
        "workspace",
        "path",
        "text",
        "expectedHash",
        "idempotencyKey"
