          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "Short description of this call"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000,
          "description": "Execution timeout in milliseconds; default 30000"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Optional unique retry key. Reuse identical code and arguments when retrying."
        }
      },
      "required": [
